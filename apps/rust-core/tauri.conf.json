{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MakerLaser",
  "version": "0.1.0",
  "identifier": "io.makerlaser.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w desktop-ui",
    "beforeBuildCommand": "npm run build -w desktop-ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MakerLaser",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Laser engraving and cutting software",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
