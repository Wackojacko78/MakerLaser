{
  "name": "makerlaser",
  "private": true,
  "version": "0.1.0",
  "description": "MakerLaser: laser engraving and cutting software.",
  "workspaces": ["apps/desktop-ui"],
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "node scripts/tauri.mjs build",
    "tauri": "node scripts/tauri.mjs",
    "ui:dev": "npm run dev -w desktop-ui",
    "ui:build": "npm run build -w desktop-ui",
    "ui:test": "npm run test -w desktop-ui",
    "ui:lint": "npm run lint -w desktop-ui",
    "ui:typecheck": "npm run typecheck -w desktop-ui",
    "rust:check": "cargo check --workspace",
    "rust:test": "cargo test --workspace",
    "rust:lint": "cargo clippy --workspace --all-targets",
    "rust:fmt": "cargo fmt --all",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
